// =====================================================================
//  RotaryPhone
//  ESP32-S3 + SIM900 GSM module turning a BT rotary telephone into a
//  working mobile phone.
//
//   * Rotary dial pulses are decoded into digits (UK style: 10 pulses = 0)
//   * Lift handset -> dial tone, dial a number, it calls automatically
//   * Incoming calls ring the real bell (25 Hz, UK double-ring cadence)
//     driven at 12 V through a stepper driver / H-bridge
//   * Handset earpiece + mic are wired straight to the SIM900 audio pins
//   * Web interface with a rotary dial, green (call/answer) and red (hang up)
//
//  Board: "ESP32S3 Dev Module" (Arduino-ESP32 core 2.x or 3.x)
//  No extra libraries needed.
// =====================================================================
#include <WiFi.h>
#include <WebServer.h>
#include <ESPmDNS.h>
#include <deque>
#include "config.h"
#include "webpage.h"

HardwareSerial SIM(1);
WebServer server(80);

// ---------------------------------------------------------------------
//  Phone state
// ---------------------------------------------------------------------
enum PhoneState { ST_IDLE, ST_OFFHOOK, ST_OUTGOING, ST_CONNECTED, ST_INCOMING, ST_ENDED };
static const char* STATE_NAMES[] = { "idle", "offhook", "outgoing", "connected", "incoming", "ended" };

// Earpiece tones (declared up here so the Arduino IDE's auto-generated
// function prototypes can see the type)
enum ToneType { TONE_NONE, TONE_DIAL, TONE_BUSY, TONE_UNOBTAINABLE };
ToneType currentTone = TONE_NONE;
enum CmdTag : uint8_t { CMD_GENERIC, CMD_DIAL, CMD_ANSWER };

PhoneState state = ST_IDLE;
bool       offHook = false;         // debounced hook switch
String     dialBuf;                 // digits collected (dial or web)
String     activeNumber;            // number of the current call
String     callerId;                // incoming caller (CLIP)
uint32_t   lastDigitMs = 0;
uint32_t   offHookSinceMs = 0;
uint32_t   callStartMs = 0;
bool       answeredIncoming = false;

// modem info
bool       simAlive = false;
String     simStatus = "starting";
String     operatorName;
int        csq = 99;

// bell control (read by bell task)
volatile bool     bellRinging = false;
volatile uint32_t bellTestUntil = 0;

// digits from the dial task
QueueHandle_t digitQueue;

// call log
struct LogEntry { char dir; String number; uint32_t at; };   // dir: 'i' in, 'o' out, 'm' missed
std::deque<LogEntry> callLog;

void addLog(char dir, const String& num) {
  callLog.push_front({ dir, num, millis() });
  while (callLog.size() > 15) callLog.pop_back();
}

// ---------------------------------------------------------------------
//  SIM900 serial handling
// ---------------------------------------------------------------------
std::deque<uint8_t> pendingCmds;     // commands waiting for a final result
uint32_t resultCount = 0;           // increments on every final result
bool     lastResultOk = false;
uint32_t lastSimRxMs = 0;
uint32_t lastSimTxMs = 0;
String   simLine;

void handleSimLine(const String& line);
void onCallEnded(const char* why);

void simSend(const String& cmd, uint8_t tag = CMD_GENERIC) {
  Serial.printf("[SIM>] %s\n", cmd.c_str());
  SIM.print(cmd);
  SIM.print("\r");
  pendingCmds.push_back(tag);
  lastSimTxMs = millis();
  if (pendingCmds.size() > 12) pendingCmds.pop_front();   // never grow forever
}

void pollSim() {
  while (SIM.available()) {
    char c = SIM.read();
    lastSimRxMs = millis();
    if (c == '\r') continue;
    if (c == '\n') {
      simLine.trim();
      if (simLine.length()) handleSimLine(simLine);
      simLine = "";
    } else if (simLine.length() < 300) {
      simLine += c;
    }
  }
}

// Blocking send - only used during start-up.
bool sendAT(const String& cmd, uint32_t timeout = 2000) {
  uint32_t before = resultCount;
  simSend(cmd);
  uint32_t t0 = millis();
  while (millis() - t0 < timeout) {
    pollSim();
    if (resultCount != before) return lastResultOk;
    delay(2);
  }
  pendingCmds.clear();
  return false;
}

void finalResult(bool ok, uint8_t* tagOut = nullptr) {
  uint8_t tag = CMD_GENERIC;
  if (!pendingCmds.empty()) { tag = pendingCmds.front(); pendingCmds.pop_front(); }
  lastResultOk = ok;
  resultCount++;
  if (tagOut) *tagOut = tag;
}

// Pull the first "quoted" string out of a modem line
String quoted(const String& line) {
  int p = line.indexOf('"');
  if (p < 0) return "";
  int q = line.indexOf('"', p + 1);
  return q > p ? line.substring(p + 1, q) : "";
}

// ---------------------------------------------------------------------
//  Tones in the earpiece (generated by the SIM900)
// ---------------------------------------------------------------------
void playTone(ToneType t) {
#if USE_SIM_TONES
  if (t == currentTone) return;
  if (currentTone != TONE_NONE) simSend("AT+STTONE=0");
  currentTone = t;
  switch (t) {
    case TONE_DIAL:         simSend("AT+STTONE=1,1,60000"); break;   // dial tone
    case TONE_BUSY:         simSend("AT+STTONE=1,2,60000"); break;   // engaged
    case TONE_UNOBTAINABLE: simSend("AT+STTONE=1,3,60000"); break;   // congestion
    default: break;
  }
#else
  (void)t;
#endif
}
void stopTone() { playTone(TONE_NONE); }

// ---------------------------------------------------------------------
//  Bell driver task - UK ring: 25 Hz in 0.4/0.2/0.4/2.0 s cadence
// ---------------------------------------------------------------------
#if BELL_DRIVER == BELL_STEPDIR
// Full-step mode: coil A changes polarity every 2 steps -> 4 steps per AC cycle
static const uint32_t BELL_HALF_MS = 1000 / (BELL_FREQ_HZ * 4 * 2);   // 5 ms
#else
static const uint32_t BELL_HALF_MS = 1000 / (BELL_FREQ_HZ * 2);       // 20 ms
#endif

static bool bellPhase = false;

void bellEnable(bool on) {
#if BELL_DRIVER == BELL_STEPDIR
  if (PIN_BELL_EN >= 0) digitalWrite(PIN_BELL_EN, on ? LOW : HIGH);   // /EN active low
  if (!on) digitalWrite(PIN_BELL_A, LOW);
#else
  if (PIN_BELL_EN >= 0) digitalWrite(PIN_BELL_EN, on ? HIGH : LOW);
  if (!on) { digitalWrite(PIN_BELL_A, LOW); digitalWrite(PIN_BELL_B, LOW); }
#endif
}

void bellToggle() {
  bellPhase = !bellPhase;
#if BELL_DRIVER == BELL_STEPDIR
  digitalWrite(PIN_BELL_A, bellPhase ? HIGH : LOW);      // STEP pulse edge
#else
  digitalWrite(PIN_BELL_A, bellPhase ? HIGH : LOW);
  digitalWrite(PIN_BELL_B, bellPhase ? LOW : HIGH);
#endif
}

bool bellShouldRing() {
  return bellRinging || (int32_t)(bellTestUntil - millis()) > 0;
}

void bellTask(void*) {
  const int segments = sizeof(UK_RING_CADENCE) / sizeof(UK_RING_CADENCE[0]);
  for (;;) {
    if (!bellShouldRing()) { bellEnable(false); vTaskDelay(pdMS_TO_TICKS(10)); continue; }
    for (int seg = 0; seg < segments && bellShouldRing(); seg++) {
      bool ringing = (seg % 2) == 0;
      bellEnable(ringing);
      uint32_t start = millis();
      while (bellShouldRing() && millis() - start < UK_RING_CADENCE[seg]) {
        if (ringing) bellToggle();
        vTaskDelay(pdMS_TO_TICKS(ringing ? BELL_HALF_MS : 10));
      }
    }
    bellEnable(false);
  }
}

// ---------------------------------------------------------------------
//  Rotary dial task - samples the pulse contact every 1 ms
// ---------------------------------------------------------------------
void dialTask(void*) {
  int stable = digitalRead(PIN_DIAL_PULSE);
  int last = stable;
  uint32_t changedAt = millis(), lastPulseAt = 0;
  int pulses = 0;
  for (;;) {
    uint32_t now = millis();
    int r = digitalRead(PIN_DIAL_PULSE);
    if (r != last) { last = r; changedAt = now; }
    if (r != stable && now - changedAt >= DIAL_DEBOUNCE_MS) {
      stable = r;
      if (stable == DIAL_PULSE_BREAK_LEVEL) { pulses++; lastPulseAt = now; }
    }
    bool dialMoving = false;
    if (PIN_DIAL_OFFNORMAL >= 0) dialMoving = digitalRead(PIN_DIAL_OFFNORMAL) == DIAL_OFFNORMAL_ACTIVE;

    if (pulses > 0 && !dialMoving && stable != DIAL_PULSE_BREAK_LEVEL &&
        now - lastPulseAt > DIAL_DIGIT_GAP_MS) {
      if (pulses <= 10) {
        int digit = pulses == 10 ? 0 : pulses;
        xQueueSend(digitQueue, &digit, 0);
      }
      pulses = 0;
    }
    vTaskDelay(1);
  }
}

// ---------------------------------------------------------------------
//  Call control
// ---------------------------------------------------------------------
void setState(PhoneState s) {
  if (s != state) Serial.printf("[STATE] %s -> %s\n", STATE_NAMES[state], STATE_NAMES[s]);
  state = s;
}

bool isCallActive() { return state == ST_OUTGOING || state == ST_CONNECTED || state == ST_INCOMING; }

void placeCall(const String& number) {
  if (number.length() == 0) return;
  stopTone();
  activeNumber = number;
  dialBuf = "";
  simSend("ATD" + number + ";", CMD_DIAL);
  addLog('o', number);
  setState(ST_OUTGOING);
}

void answerCall() {
  if (state != ST_INCOMING) return;
  bellRinging = false;
  simSend("ATA", CMD_ANSWER);
  answeredIncoming = true;
  addLog('i', callerId);
  callStartMs = millis();
  setState(ST_CONNECTED);
}

void hangUp() {
  bellRinging = false;
  if (state == ST_INCOMING && !answeredIncoming) addLog('m', callerId);
  if (isCallActive()) simSend("ATH");
  dialBuf = "";
  if (offHook) {                      // handset still up -> fresh dial tone
    offHookSinceMs = millis();
    setState(ST_OFFHOOK);
    playTone(TONE_DIAL);
  } else {
    stopTone();
    setState(ST_IDLE);
  }
}

void onIncoming(const String& number) {
  if (number.length()) callerId = number;
  if (state == ST_INCOMING) return;
  if (state != ST_IDLE) {             // handset up / already busy -> reject
    if (state == ST_OFFHOOK || state == ST_ENDED) simSend("ATH");
    return;
  }
  if (!number.length()) callerId = "";
  answeredIncoming = false;
  setState(ST_INCOMING);
  bellRinging = true;
}

void onCallEnded(const char* why) {
  if (!isCallActive()) return;        // already handled (we hung up ourselves)
  Serial.printf("[CALL] ended: %s\n", why);
  bellRinging = false;
  if (state == ST_INCOMING && !answeredIncoming) addLog('m', callerId);
  if (offHook) {
    setState(ST_ENDED);
    playTone(strcmp(why, "BUSY") == 0 ? TONE_BUSY : TONE_UNOBTAINABLE);
  } else {
    stopTone();
    setState(ST_IDLE);
  }
}

void onDigit(int d) {
  char c = '0' + d;
  Serial.printf("[DIAL] %c\n", c);
  switch (state) {
    case ST_CONNECTED:                // digits during a call -> DTMF (menus etc.)
      simSend(String("AT+VTS=") + c);
      break;
    case ST_OFFHOOK:
      stopTone();
      // fall through
    case ST_IDLE:
      if (dialBuf.length() < 20) dialBuf += c;
      lastDigitMs = millis();
      break;
    default: break;
  }
}

// UK numbers: 999/112 are complete straight away, 11-digit 0xxxx numbers too.
bool numberComplete(const String& n) {
  if (n == "999" || n == "112") return true;
  if (n.startsWith("00")) return false;           // international: wait for timeout
  if (n.startsWith("0") && n.length() >= 11) return true;
  return false;
}

void onLiftHandset() {
  Serial.println("[HOOK] off hook");
  switch (state) {
    case ST_INCOMING: answerCall(); break;
    case ST_IDLE:
      offHookSinceMs = millis();
      if (dialBuf.length()) { lastDigitMs = millis(); setState(ST_OFFHOOK); }   // pre-dialled on web
      else { setState(ST_OFFHOOK); playTone(TONE_DIAL); }
      break;
    default: break;                   // call already in progress (started from web)
  }
}

void onReplaceHandset() {
  Serial.println("[HOOK] on hook");
  if (state == ST_INCOMING) return;   // can't really happen (already on hook) - keep ringing
  if (isCallActive()) simSend("ATH");
  bellRinging = false;
  stopTone();
  dialBuf = "";
  setState(ST_IDLE);
}

void pollHook() {
  static bool lastRaw = offHook;
  static uint32_t changedAt = 0;
  bool raw = digitalRead(PIN_HOOK) == HOOK_OFF_LEVEL;
  if (raw != lastRaw) { lastRaw = raw; changedAt = millis(); }
  if (raw != offHook && millis() - changedAt >= HOOK_DEBOUNCE_MS) {
    offHook = raw;
    if (offHook) onLiftHandset(); else onReplaceHandset();
  }
}

// ---------------------------------------------------------------------
//  Parse everything the modem says
// ---------------------------------------------------------------------
void handleSimLine(const String& line) {
  Serial.printf("[SIM<] %s\n", line.c_str());

  if (line == "OK") { finalResult(true); return; }
  if (line == "ERROR" || line.startsWith("+CME ERROR") || line.startsWith("+CMS ERROR")) {
    uint8_t tag; finalResult(false, &tag);
    if (tag == CMD_DIAL) onCallEnded("ERROR");
    return;
  }
  if (line == "NO CARRIER" || line == "BUSY" || line == "NO ANSWER" || line == "NO DIALTONE") {
    if (!pendingCmds.empty() && pendingCmds.front() != CMD_GENERIC) finalResult(false);
    onCallEnded(line.c_str());
    return;
  }
  if (line == "RING") { onIncoming(""); return; }

  if (line.startsWith("+CLIP:")) {
    String n = quoted(line);
    if (state == ST_INCOMING && n.length()) callerId = n;
    else onIncoming(n);
    return;
  }

  // +CLCC: <id>,<dir>,<stat>,<mode>,<mpty>,"<number>",<type>
  if (line.startsWith("+CLCC:")) {
    int f[3] = { 0, 0, 0 };
    int p = 6;
    for (int k = 0; k < 3; k++) {
      int c = line.indexOf(',', p);
      f[k] = line.substring(p, c < 0 ? line.length() : c).toInt();
      if (c < 0) break;
      p = c + 1;
    }
    int stat = f[2];
    String num = quoted(line);
    switch (stat) {
      case 0:   // active
        bellRinging = false;
        if (state == ST_OUTGOING || state == ST_INCOMING) {
          if (state == ST_INCOMING) { answeredIncoming = true; addLog('i', num.length() ? num : callerId); }
          callStartMs = millis();
          setState(ST_CONNECTED);
        }
        break;
      case 2: case 3:   // dialling / alerting
        break;
      case 4:   // incoming
        onIncoming(num);
        break;
      case 6:   // disconnected
        onCallEnded("released");
        break;
    }
    return;
  }

  if (line.startsWith("+CSQ:")) { csq = line.substring(5).toInt(); return; }
  if (line.startsWith("+COPS:")) { String op = quoted(line); if (op.length()) operatorName = op; return; }
  if (line.startsWith("+CPIN:")) {
    if (line.indexOf("READY") >= 0) simStatus = "ready";
    else if (line.indexOf("SIM PIN") >= 0) {
      simStatus = "PIN required";
      if (strlen(SIM_PIN_CODE)) simSend(String("AT+CPIN=") + SIM_PIN_CODE);
    } else simStatus = line.substring(7);
    return;
  }
  if (line.startsWith("+CREG:")) {
    int stat = line.substring(line.lastIndexOf(',') + 1).toInt();
    if (line.indexOf(',') < 0) stat = line.substring(6).toInt();
    simStatus = (stat == 1 || stat == 5) ? "registered" : (stat == 2 ? "searching" : "no network");
    return;
  }
  if (line == "Call Ready") { simStatus = "registered"; return; }
  if (line == "NORMAL POWER DOWN") { simAlive = false; simStatus = "powered down"; return; }
}

// ---------------------------------------------------------------------
//  SIM900 start-up
// ---------------------------------------------------------------------
void simPowerPulse() {
  if (PIN_SIM_PWRKEY < 0) return;
  Serial.println("[SIM] pulsing PWRKEY");
  digitalWrite(PIN_SIM_PWRKEY, HIGH);
  delay(1200);
  digitalWrite(PIN_SIM_PWRKEY, LOW);
  delay(3000);
}

bool simPing() {
  for (int i = 0; i < 4; i++) if (sendAT("AT", 500)) return true;
  return false;
}

void simInit() {
  if (!simPing()) { simPowerPulse(); simPing(); }
  simAlive = simPing();
  if (!simAlive) { simStatus = "no response"; Serial.println("[SIM] not responding!"); return; }

  sendAT("ATE0");                                         // no echo
  sendAT("AT+CMEE=2");                                    // verbose errors
  sendAT("AT+CLIP=1");                                    // caller ID
  sendAT("AT+CLCC=1");                                    // call status reports
  sendAT("AT+CALM=1");                                    // mute modem's own ring tone (we have a bell!)
  sendAT("AT+CHFA=0");                                    // main audio channel (MIC1/SPK1)
  sendAT(String("AT+CLVL=") + SPEAKER_VOLUME);
  sendAT(String("AT+CMIC=0,") + MIC_GAIN);
  sendAT("AT+CPIN?");
  sendAT("AT+CREG?");
  sendAT("AT+COPS?", 5000);
  sendAT("AT+CSQ");
  if (simStatus == "starting") simStatus = "ready";
}

// ---------------------------------------------------------------------
//  Web interface
// ---------------------------------------------------------------------
String jsonEscape(const String& s) {
  String o;
  for (char c : s) {
    if (c == '"' || c == '\\') { o += '\\'; o += c; }
    else if ((uint8_t)c >= 0x20) o += c;
  }
  return o;
}

bool webAuth() {
  if (strlen(WEB_USER) == 0) return true;
  if (server.authenticate(WEB_USER, WEB_PASS)) return true;
  server.requestAuthentication();
  return false;
}

void sendStatus() {
  String j = "{";
  j += "\"state\":\"" + String(STATE_NAMES[state]) + "\"";
  j += ",\"hook\":" + String(offHook ? "true" : "false");
  j += ",\"dial\":\"" + jsonEscape(dialBuf) + "\"";
  j += ",\"number\":\"" + jsonEscape(activeNumber) + "\"";
  j += ",\"caller\":\"" + jsonEscape(callerId) + "\"";
  j += ",\"csq\":" + String(csq);
  j += ",\"op\":\"" + jsonEscape(operatorName) + "\"";
  j += ",\"sim\":\"" + jsonEscape(simStatus) + "\"";
  j += ",\"now\":" + String(millis());
  j += ",\"callStart\":" + String(callStartMs);
  j += ",\"ip\":\"" + (WiFi.getMode() == WIFI_AP ? WiFi.softAPIP().toString() : WiFi.localIP().toString()) + "\"";
  j += ",\"log\":[";
  for (size_t i = 0; i < callLog.size(); i++) {
    if (i) j += ",";
    j += "{\"d\":\"" + String(callLog[i].dir) + "\",\"n\":\"" + jsonEscape(callLog[i].number) +
         "\",\"t\":" + String(callLog[i].at) + "}";
  }
  j += "]}";
  server.sendHeader("Cache-Control", "no-store");
  server.send(200, "application/json", j);
}

void webOk() { sendStatus(); }

void setupWeb() {
  server.on("/", HTTP_GET, [] { if (!webAuth()) return; server.send_P(200, "text/html", INDEX_HTML); });
  server.on("/api/status", HTTP_GET, [] { if (!webAuth()) return; sendStatus(); });

  server.on("/api/digit", HTTP_POST, [] {
    if (!webAuth()) return;
    String d = server.arg("d");
    if (d.length() == 1 && isDigit(d[0])) onDigit(d[0] - '0');
    else if (d == "*" || d == "#") {
      if (state == ST_CONNECTED) simSend("AT+VTS=" + d);
      else if (dialBuf.length() < 20) dialBuf += d;
    }
    webOk();
  });

  server.on("/api/number", HTTP_POST, [] {             // set whole number (from call log)
    if (!webAuth()) return;
    if (state == ST_IDLE || state == ST_OFFHOOK) {
      String n = server.arg("n"), clean;
      for (char c : n) if (isDigit(c) || c == '+' || c == '*' || c == '#') clean += c;
      dialBuf = clean.substring(0, 20);
      lastDigitMs = millis();
      if (state == ST_OFFHOOK) stopTone();
    }
    webOk();
  });

  server.on("/api/backspace", HTTP_POST, [] {
    if (!webAuth()) return;
    if (dialBuf.length()) dialBuf.remove(dialBuf.length() - 1);
    lastDigitMs = millis();
    webOk();
  });

  server.on("/api/call", HTTP_POST, [] {                // GREEN button
    if (!webAuth()) return;
    if (state == ST_INCOMING) answerCall();
    else if ((state == ST_IDLE || state == ST_OFFHOOK) && dialBuf.length()) placeCall(dialBuf);
    webOk();
  });

  server.on("/api/hangup", HTTP_POST, [] {              // RED button
    if (!webAuth()) return;
    if (isCallActive() || state == ST_ENDED) hangUp();
    else dialBuf = "";
    webOk();
  });

  server.on("/api/bell", HTTP_POST, [] {                // ring the bell for a test
    if (!webAuth()) return;
    if (!isCallActive()) bellTestUntil = millis() + 6000;
    webOk();
  });

  server.onNotFound([] { server.send(404, "text/plain", "Not found"); });
  server.begin();
}

void setupWiFi() {
  WiFi.mode(WIFI_STA);
  WiFi.setHostname(HOSTNAME);
  WiFi.begin(WIFI_SSID, WIFI_PASS);
  Serial.printf("[WIFI] connecting to %s", WIFI_SSID);
  uint32_t t0 = millis();
  while (WiFi.status() != WL_CONNECTED && millis() - t0 < 15000) { delay(250); Serial.print('.'); }
  Serial.println();
  if (WiFi.status() == WL_CONNECTED) {
    Serial.printf("[WIFI] connected, IP %s\n", WiFi.localIP().toString().c_str());
  } else {
    WiFi.mode(WIFI_AP);
    WiFi.softAP(AP_SSID, AP_PASS);
    Serial.printf("[WIFI] access point '%s', IP %s\n", AP_SSID, WiFi.softAPIP().toString().c_str());
  }
  if (MDNS.begin(HOSTNAME)) MDNS.addService("http", "tcp", 80);
}

// ---------------------------------------------------------------------
//  Arduino entry points
// ---------------------------------------------------------------------
void setup() {
  Serial.begin(115200);
  delay(300);
  Serial.println("\n=== RotaryPhone starting ===");

  pinMode(PIN_HOOK, INPUT_PULLUP);
  pinMode(PIN_DIAL_PULSE, INPUT_PULLUP);
  if (PIN_DIAL_OFFNORMAL >= 0) pinMode(PIN_DIAL_OFFNORMAL, INPUT_PULLUP);
  pinMode(PIN_BELL_A, OUTPUT);
  pinMode(PIN_BELL_B, OUTPUT);
  digitalWrite(PIN_BELL_B, LOW);               // DIR fixed / IN2 low
  if (PIN_BELL_EN >= 0) pinMode(PIN_BELL_EN, OUTPUT);
  bellEnable(false);
  if (PIN_SIM_PWRKEY >= 0) { pinMode(PIN_SIM_PWRKEY, OUTPUT); digitalWrite(PIN_SIM_PWRKEY, LOW); }

  offHook = digitalRead(PIN_HOOK) == HOOK_OFF_LEVEL;

  digitQueue = xQueueCreate(16, sizeof(int));
  xTaskCreatePinnedToCore(bellTask, "bell", 3072, nullptr, 2, nullptr, 1);
  xTaskCreatePinnedToCore(dialTask, "dial", 3072, nullptr, 3, nullptr, 1);

  setupWiFi();
  setupWeb();

  SIM.begin(SIM_BAUD, SERIAL_8N1, PIN_SIM_RX, PIN_SIM_TX);
  simInit();

  if (offHook) { offHookSinceMs = millis(); setState(ST_OFFHOOK); playTone(TONE_DIAL); }
  Serial.println("=== ready ===");
}

void loop() {
  server.handleClient();
  pollSim();
  pollHook();

  int d;
  while (xQueueReceive(digitQueue, &d, 0) == pdTRUE) onDigit(d);

  uint32_t now = millis();

  // Auto-dial when the handset is up and the number looks complete / timed out
  if (state == ST_OFFHOOK && dialBuf.length()) {
    if (numberComplete(dialBuf) || (now - lastDigitMs > DIAL_TIMEOUT_MS && dialBuf.length() >= 3))
      placeCall(dialBuf);
  }
  // Left off hook without dialling -> number unobtainable, like a real exchange
  if (state == ST_OFFHOOK && dialBuf.length() == 0 && now - offHookSinceMs > DIALTONE_TIMEOUT_MS) {
    setState(ST_ENDED);
    playTone(TONE_UNOBTAINABLE);
  }

  // Housekeeping: signal + network every 15 s (not while ringing/dialling)
  static uint32_t lastPoll = 0;
  if (simAlive && now - lastPoll > 15000 && (state == ST_IDLE || state == ST_CONNECTED)) {
    lastPoll = now;
    simSend("AT+CSQ");
    simSend("AT+CREG?");
    if (!operatorName.length()) simSend("AT+COPS?");
  }
  // If the modem stops answering commands, don't let the queue get stuck
  if (!pendingCmds.empty() && now - lastSimRxMs > 10000 && now - lastSimTxMs > 10000) pendingCmds.clear();

  // Try to bring a dead modem back every 30 s
  static uint32_t lastRevive = 0;
  if (!simAlive && state == ST_IDLE && now - lastRevive > 30000) {
    lastRevive = now;
    simInit();
  }
}
